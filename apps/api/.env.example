# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/lms_saas

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT - RS256 Keys (generate with: openssl genrsa -out private.key 2048)
JWT_ACCESS_PRIVATE_KEY_PATH=./keys/access_private.key
JWT_ACCESS_PUBLIC_KEY_PATH=./keys/access_public.key
JWT_REFRESH_PRIVATE_KEY_PATH=./keys/refresh_private.key
JWT_REFRESH_PUBLIC_KEY_PATH=./keys/refresh_public.key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=no-reply@lms.com

# App
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# Logging
LOG_LEVEL=debug
