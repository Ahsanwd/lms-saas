# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/lms_saas

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT - RS256 Keys (generate with: openssl genrsa -out private.key 2048)
JWT_ACCESS_PRIVATE_KEY_PATH=./keys/access_private.key
JWT_ACCESS_PUBLIC_KEY_PATH=./keys/access_public.key
JWT_REFRESH_PRIVATE_KEY_PATH=./keys/refresh_private.key
JWT_REFRESH_PUBLIC_KEY_PATH=./keys/refresh_public.key
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=no-reply@lms.com

# App
APP_URL=http://localhost:3000
API_URL=http://localhost:5000

# Storage
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./uploads

# Cloudflare Stream (shared across all tenants — leave blank to disable video upload via CF Stream)
CF_STREAM_ACCOUNT_ID=
CF_STREAM_API_TOKEN=
CF_STREAM_SIGNING_KEY_ID=
CF_STREAM_SIGNING_KEY_PEM=

# Lemon Squeezy (subscription billing)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LS_VARIANT_BASIC_MONTHLY=
LS_VARIANT_BASIC_YEARLY=
LS_VARIANT_PRO_MONTHLY=
LS_VARIANT_PRO_YEARLY=
# One-time Cloudflare Stream top-up packs (Basic/Pro only, Free is hard-locked)
LS_VARIANT_TOPUP_STORAGE_500=
LS_VARIANT_TOPUP_VIEWER_5000=

# Logging
LOG_LEVEL=debug
